*,
*::before,
*::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --cor-primaria: #6366f1;
    --cor-primaria-escura: #4f46e5;
    --cor-secundaria: #0ea5e9;
    --cor-fundo: #0f172a;
    --cor-fundo-secundario: #1e293b;
    --cor-fundo-card: #334155;
    --cor-texto: #f1f5f9;
    --cor-texto-secundaria: #94a3b8;
    --cor-borda: #334155;
    --gradiente: linear-gradient(135deg, var(--cor-primaria), var(--cor-secundaria));
    --sombra: 0 10px 40px rgba(0, 0, 0, 0.3);
    --transicao: all 0.3s ease;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background-color: var(--cor-fundo);
    color: var(--cor-texto);
    line-height: 1.6;
    overflow-x: hidden;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
}

/* Navbar */
.navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(15, 23, 42, 0.9);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--cor-borda);
    transition: var(--transicao);
}

.navbar.scrolled {
    box-shadow: var(--sombra);
}

.nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 70px;
}

.nav-logo {
    font-size: 1.5rem;
    font-weight: 700;
    background: var(--gradiente);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-decoration: none;
}

.nav-menu {
    display: flex;
    list-style: none;
    gap: 8px;
}

.nav-link {
    color: var(--cor-texto-secundaria);
    text-decoration: none;
    padding: 8px 16px;
    border-radius: 8px;
    transition: var(--transicao);
    font-weight: 500;
}

.nav-link:hover,
.nav-link.active {
    color: var(--cor-texto);
    background: var(--cor-fundo-secundario);
}

.nav-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
}

.hamburger {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--cor-texto);
    position: relative;
    transition: var(--transicao);
}

.hamburger::before,
.hamburger::after {
    content: '';
    position: absolute;
    width: 24px;
    height: 2px;
    background: var(--cor-texto);
    transition: var(--transicao);
}

.hamburger::before {
    top: -8px;
}

.hamburger::after {
    top: 8px;
}

/* Hero */
.hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 100px 24px 60px;
    position: relative;
    overflow: hidden;
}

.hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.15), transparent 70%);
    border-radius: 50%;
    pointer-events: none;
}

.hero::after {
    content: '';
    position: absolute;
    bottom: -30%;
    left: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(14, 165, 233, 0.1), transparent 70%);
    border-radius: 50%;
    pointer-events: none;
}

.hero-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    position: relative;
    z-index: 1;
}

.hero-saudacao {
    font-size: 1.1rem;
    color: var(--cor-secundaria);
    font-weight: 500;
    margin-bottom: 8px;
}

.hero-nome {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 16px;
    background: var(--gradiente);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero-titulo {
    font-size: clamp(1.2rem, 2.5vw, 1.8rem);
    color: var(--cor-texto-secundaria);
    font-weight: 400;
    margin-bottom: 24px;
    min-height: 40px;
}

.hero-titulo::after {
    content: '|';
    animation: blink 1s infinite;
    color: var(--cor-primaria);
}

@keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
}

.hero-descricao {
    font-size: 1.1rem;
    color: var(--cor-texto-secundaria);
    margin-bottom: 32px;
    max-width: 500px;
}

.hero-botoes {
    display: flex;
    gap: 16px;
    margin-bottom: 40px;
}

.btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: 12px;
    font-weight: 600;
    text-decoration: none;
    transition: var(--transicao);
    cursor: pointer;
    border: none;
    font-size: 1rem;
}

.btn-primario {
    background: var(--gradiente);
    color: white;
    box-shadow: 0 4px 20px rgba(99, 102, 241, 0.4);
}

.btn-primario:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(99, 102, 241, 0.5);
}

.btn-secundario {
    background: var(--cor-fundo-secundario);
    color: var(--cor-texto);
    border: 1px solid var(--cor-borda);
}

.btn-secundario:hover {
    background: var(--cor-fundo-card);
    transform: translateY(-2px);
}

.btn-pequeno {
    padding: 10px 20px;
    font-size: 0.9rem;
    border-radius: 8px;
}

.btn-outline {
    background: transparent;
    border: 1px solid var(--cor-borda);
    color: var(--cor-texto-secundaria);
}

.btn-outline:hover {
    background: var(--cor-fundo-secundario);
    color: var(--cor-texto);
}

.btn-full {
    width: 100%;
    justify-content: center;
}

.hero-social {
    display: flex;
    gap: 16px;
}

.social-link {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--cor-fundo-secundario);
    border-radius: 12px;
    color: var(--cor-texto-secundaria);
    transition: var(--transicao);
    border: 1px solid var(--cor-borda);
}

.social-link:hover {
    background: var(--cor-primaria);
    color: white;
    transform: translateY(-3px);
    border-color: var(--cor-primaria);
}

.hero-avatar {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
}

.avatar-circle {
    width: 300px;
    height: 300px;
    background: var(--gradiente);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
}

.avatar-inicial {
    font-size: 5rem;
    font-weight: 700;
    color: white;
}

.avatar-ring {
    position: absolute;
    width: 340px;
    height: 340px;
    border: 2px dashed var(--cor-primaria);
    border-radius: 50%;
    animation: rotate 20s linear infinite;
    opacity: 0.5;
}

@keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.scroll-indicator {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--cor-texto-secundaria);
    font-size: 0.85rem;
    animation: bounce 2s infinite;
}

.scroll-arrow {
    width: 24px;
    height: 24px;
    border-right: 2px solid var(--cor-texto-secundaria);
    border-bottom: 2px solid var(--cor-texto-secundaria);
    transform: rotate(45deg);
}

@keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateX(-50%) translateY(0); }
    40% { transform: translateX(-50%) translateY(-10px); }
    60% { transform: translateX(-50%) translateY(-5px); }
}

/* Sections */
section {
    padding: 100px 0;
}

.section-title {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 16px;
    background: var(--gradiente);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.section-subtitle {
    text-align: center;
    color: var(--cor-texto-secundaria);
    margin-bottom: 60px;
    font-size: 1.1rem;
}

/* Sobre */
.sobre {
    background: var(--cor-fundo-secundario);
}

.sobre-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 60px;
    margin-bottom: 60px;
}

.sobre-texto p {
    color: var(--cor-texto-secundaria);
    margin-bottom: 20px;
    font-size: 1.05rem;
}

.sobre-texto strong {
    color: var(--cor-secundaria);
}

.sobre-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.card-sobre {
    background: var(--cor-fundo);
    padding: 30px;
    border-radius: 16px;
    border: 1px solid var(--cor-borda);
    transition: var(--transicao);
}

.card-sobre:hover {
    transform: translateY(-5px);
    border-color: var(--cor-primaria);
    box-shadow: 0 10px 40px rgba(99, 102, 241, 0.2);
}

.card-icone {
    width: 56px;
    height: 56px;
    background: var(--gradiente);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    color: white;
}

.card-sobre h3 {
    font-size: 1.2rem;
    margin-bottom: 16px;
    color: var(--cor-texto);
}

.card-sobre ul {
    list-style: none;
}

.card-sobre li {
    color: var(--cor-texto-secundaria);
    padding: 8px 0;
    border-bottom: 1px solid var(--cor-borda);
    position: relative;
    padding-left: 20px;
}

.card-sobre li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--cor-primaria);
}

.tecnologias {
    text-align: center;
}

.tecnologias h3 {
    font-size: 1.3rem;
    margin-bottom: 30px;
    color: var(--cor-texto);
}

.tech-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
}

.tech-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    background: var(--cor-fundo);
    border-radius: 12px;
    border: 1px solid var(--cor-borda);
    transition: var(--transicao);
    cursor: default;
}

.tech-item:hover {
    border-color: var(--cor-primaria);
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(99, 102, 241, 0.2);
}

.tech-icon {
    font-size: 1.5rem;
}

/* Projetos */
.projetos {
    background: var(--cor-fundo);
}

.projetos-filtros {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 40px;
    flex-wrap: wrap;
}

.filtro-btn {
    padding: 10px 24px;
    background: var(--cor-fundo-secundario);
    border: 1px solid var(--cor-borda);
    border-radius: 8px;
    color: var(--cor-texto-secundaria);
    cursor: pointer;
    font-weight: 500;
    transition: var(--transicao);
}

.filtro-btn:hover,
.filtro-btn.active {
    background: var(--cor-primaria);
    color: white;
    border-color: var(--cor-primaria);
}

.projetos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 30px;
}

.projeto-card {
    background: var(--cor-fundo-secundario);
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--cor-borda);
    transition: var(--transicao);
}

.projeto-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
    border-color: var(--cor-primaria);
}

.projeto-imagem {
    height: 200px;
    background: var(--cor-fundo-card);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.projeto-placeholder {
    font-size: 4rem;
}

.projeto-overlay {
    position: absolute;
    inset: 0;
    background: rgba(99, 102, 241, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: var(--transicao);
}

.projeto-card:hover .projeto-overlay {
    opacity: 1;
}

.projeto-link {
    width: 60px;
    height: 60px;
    background: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cor-primaria);
    transform: scale(0);
    transition: var(--transicao);
}

.projeto-card:hover .projeto-link {
    transform: scale(1);
}

.projeto-info {
    padding: 24px;
}

.projeto-tags {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
    flex-wrap: wrap;
}

.tag {
    padding: 4px 12px;
    background: rgba(99, 102, 241, 0.2);
    color: var(--cor-primaria);
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 500;
}

.projeto-info h3 {
    font-size: 1.3rem;
    margin-bottom: 12px;
    color: var(--cor-texto);
}

.projeto-info p {
    color: var(--cor-texto-secundaria);
    margin-bottom: 20px;
    font-size: 0.95rem;
}

.projeto-botoes {
    display: flex;
    gap: 12px;
}

/* Contato */
.contato {
    background: var(--cor-fundo-secundario);
}

.contato-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
}

.contato-item {
    display: flex;
    gap: 20px;
    padding: 24px;
    background: var(--cor-fundo);
    border-radius: 16px;
    border: 1px solid var(--cor-borda);
    margin-bottom: 20px;
    transition: var(--transicao);
}

.contato-item:hover {
    border-color: var(--cor-primaria);
    transform: translateX(5px);
}

.contato-icone {
    width: 50px;
    height: 50px;
    background: var(--gradiente);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    flex-shrink: 0;
}

.contato-dados h4 {
    font-size: 1rem;
    margin-bottom: 4px;
    color: var(--cor-texto);
}

.contato-dados a {
    color: var(--cor-texto-secundaria);
    text-decoration: none;
    transition: var(--transicao);
}

.contato-dados a:hover {
    color: var(--cor-primaria);
}

.contato-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.form-grupo {
    position: relative;
}

.form-grupo input,
.form-grupo textarea {
    width: 100%;
    padding: 16px;
    background: var(--cor-fundo);
    border: 1px solid var(--cor-borda);
    border-radius: 12px;
    color: var(--cor-texto);
    font-family: inherit;
    font-size: 1rem;
    transition: var(--transicao);
}

.form-grupo input:focus,
.form-grupo textarea:focus {
    outline: none;
    border-color: var(--cor-primaria);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
}

.form-grupo label {
    position: absolute;
    left: 16px;
    top: 16px;
    color: var(--cor-texto-secundaria);
    pointer-events: none;
    transition: var(--transicao);
}

.form-grupo input:focus + label,
.form-grupo input:not(:placeholder-shown) + label,
.form-grupo textarea:focus + label,
.form-grupo textarea:not(:placeholder-shown) + label {
    top: -10px;
    left: 12px;
    font-size: 0.85rem;
    background: var(--cor-fundo-secundario);
    padding: 2px 8px;
    border-radius: 4px;
    color: var(--cor-primaria);
}

/* Footer */
.footer {
    background: var(--cor-fundo);
    padding: 40px 0;
    text-align: center;
    border-top: 1px solid var(--cor-borda);
}

.footer p {
    color: var(--cor-texto-secundaria);
    margin-bottom: 8px;
}

.footer-sub {
    font-size: 0.9rem;
    color: var(--cor-texto-secundaria);
    opacity: 0.7;
}

/* Botão Topo */
.btn-topo {
    position: fixed;
    bottom: 30px;
    right: 30px;
    width: 50px;
    height: 50px;
    background: var(--gradiente);
    border: none;
    border-radius: 12px;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    transition: var(--transicao);
    z-index: 999;
    box-shadow: 0 4px 20px rgba(99, 102, 241, 0.4);
}

.btn-topo.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.btn-topo:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(99, 102, 241, 0.5);
}

/* Animações de entrada */
.fade-in {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease, transform 0.6s ease;
}

.fade-in.visible {
    opacity: 1;
    transform: translateY(0);
}

/* Responsive */
@media (max-width: 1024px) {
    .sobre-grid {
        grid-template-columns: 1fr;
        gap: 40px;
    }

    .sobre-cards {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 768px) {
    .nav-toggle {
        display: block;
    }

    .nav-menu {
        position: fixed;
        top: 70px;
        left: 0;
        right: 0;
        background: var(--cor-fundo-secundario);
        flex-direction: column;
        padding: 20px;
        gap: 8px;
        border-bottom: 1px solid var(--cor-borda);
        transform: translateY(-100%);
        opacity: 0;
        visibility: hidden;
        transition: var(--transicao);
    }

    .nav-menu.active {
        transform: translateY(0);
        opacity: 1;
        visibility: visible;
    }

    .hero-container {
        grid-template-columns: 1fr;
        text-align: center;
    }

    .hero-content {
        order: 2;
    }

    .hero-avatar {
        order: 1;
    }

    .avatar-circle {
        width: 200px;
        height: 200px;
    }

    .avatar-inicial {
        font-size: 3.5rem;
    }

    .avatar-ring {
        width: 230px;
        height: 230px;
    }

    .hero-descricao {
        margin-left: auto;
        margin-right: auto;
    }

    .hero-botoes {
        justify-content: center;
    }

    .hero-social {
        justify-content: center;
    }

    .sobre-cards {
        grid-template-columns: 1fr;
    }

    .projetos-grid {
        grid-template-columns: 1fr;
    }

    .contato-grid {
        grid-template-columns: 1fr;
    }

    .scroll-indicator {
        display: none;
    }
}

@media (max-width: 480px) {
    .hero-botoes {
        flex-direction: column;
    }

    .btn {
        width: 100%;
        justify-content: center;
    }

    .projeto-botoes {
        flex-direction: column;
    }

    .projeto-botoes .btn {
        width: 100%;
        justify-content: center;
    }
}

/* Toast de sucesso */
.toast {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    background: #10b981;
    color: white;
    padding: 16px 32px;
    border-radius: 12px;
    font-weight: 500;
    box-shadow: 0 10px 40px rgba(16, 185, 129, 0.4);
    z-index: 10000;
    opacity: 0;
    transition: all 0.4s ease;
}

.toast.show {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
}
